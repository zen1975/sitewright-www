---
import siteProfile from '../../config/site-profile.json';
const repo = siteProfile.officialSite.repositoryUrl;
const links = [
  { href: '/#how', label: 'How it works' },
  { href: '/#proof', label: 'Proof' },
  { href: '/#roadmap', label: 'Roadmap' },
  { href: '/news/', label: 'Updates' },
  { href: repo, label: 'GitHub' }
];
---
<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-brand" href="/">Sitewright</a>
    <nav aria-label="Main navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</header>

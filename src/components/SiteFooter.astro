---
import siteProfile from '../../config/site-profile.json';
const repo = siteProfile.officialSite.repositoryUrl;
---
<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div>
      <strong>Sitewright</strong>
      <p>Open infrastructure for AI-operated websites.<br />
      Astro · Cloudflare Workers · D1 · R2 · MIT</p>
    </div>
    <div>
      <p>
        <a href={repo}>GitHub</a> ·
        <a href={`${repo}/blob/main/docs/QUICK_START.md`}>Quick Start</a> ·
        <a href={`${repo}/issues`}>Issues</a>
      </p>
      <p><small>This site is operated by the software it documents.</small></p>
    </div>
  </div>
</footer>

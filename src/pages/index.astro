---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentCard from '@/components/ContentCard.astro';
import PageCompositionRenderer from '@/components/PageCompositionRenderer.astro';
import TimedContentSlot from '@/components/TimedContentSlot.astro';
import { loadPageCompositionBySlug } from '@/server/page-composition/renderer';
import { getNewsWithMedia } from '@/lib/content';

/**
 * The landing page is stored as page sections, not written here.
 *
 * Everything a visitor reads on this page can be changed by the operator path
 * this project documents: update_page_section, reorder_page_sections and the
 * rest. If the copy on the official site could only be changed by editing this
 * file, the claim the site makes would not hold for the site itself.
 *
 * This route only fetches that page and renders it. `/home/` resolves the same
 * composition through the catch-all route.
 */
const composition = await loadPageCompositionBySlug('home');
const news = await getNewsWithMedia(3);
---
<BaseLayout
  title={composition?.page.seoTitle || 'Sitewright'}
  description={composition?.page.seoDescription || ''}>
  <Fragment slot="global-top"><TimedContentSlot placement="global_top" /></Fragment>

  {composition
    ? <PageCompositionRenderer composition={composition} />
    : <main class="section"><div class="shell">
        <h1>Sitewright</h1>
        <p class="lp-lede">The landing page has not been published yet.</p>
      </div></main>}

  <section class="section"><div class="shell">
    <p class="eyebrow">Updates</p>
    <h2>Posted the same way you would post.</h2>
    <div class="card-grid">
      {news.length > 0
        ? news.map((item) => <ContentCard title={item.title} excerpt={item.excerpt} href={`/news/${item.slug}/`} meta={item.published_at?.slice(0,10)} />)
        : <p class="empty-state">Updates published through the operation layer will appear here.</p>}
    </div>
  </div></section>
</BaseLayout>

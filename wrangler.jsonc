{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitewright-site",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-01",

  // Custom domain for the official site. Workers provisions the DNS record and
  // the certificate itself, because the zone is already in the same account.
  "routes": [
    { "pattern": "sitewright.data-range.com", "custom_domain": true },
    // Kept only so the pre-rename hostname can answer with a 301. See
    // src/middleware.ts. Remove once nothing points at the old name.
    // The old product name. The zone's Single Redirect sends it to
    // sitewright.data-range.com before a request ever reaches this Worker, so
    // nothing here serves it. The binding stays because it is what keeps the
    // hostname's proxied DNS record alive -- remove it and the redirect has no
    // hostname to fire on.
    { "pattern": "chatgpt-operated-site.data-range.com", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cos-site-content",
      "database_id": "7c82a075-8c27-4056-885d-f4305ac7f457",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "cos-site-assets"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "bf8065e184d94f23857ec2bc624712d3"
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://sitewright.data-range.com",
    "SITE_TIMEZONE": "UTC",
    "COMMAND_TRUSTED_ACTOR": "github-actions",
    "CONTROL_READ_SCOPES": "intake:read,command:preflight,content:read,page:read",
    "COMMAND_TRUSTED_SCOPES": "content:write,content:archive,content:rollback,asset:write,product:create,product:update,product:archive,product:asset,product:rollback,page:write,page:structure,page:rollback,page:item:write,taxonomy:write"
  }
}
